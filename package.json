{
  "name": "tic-tac-toe",
  "private": true,
  "type": "module",
  "scripts": {
    "benchmark:custom-events": "NODE_ENV=test remix test --glob.test app/assets/utils/customEvents/subscriptionMatching.bench.browser.tsx --glob.browser app/assets/utils/customEvents/subscriptionMatching.bench.browser.tsx --browser.echo",
    "dev": "NODE_ENV=development node --watch --import remix/node-tsx server.ts",
    "start": "NODE_ENV=production node --import remix/node-tsx server.ts",
    "test": "NODE_ENV=test remix test",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=24.3.0"
  },
  "dependencies": {
    "immer": "^11.1.15",
    "remix": "3.0.0-beta.5",
    "ts-pattern": "^5.9.0"
  },
  "devDependencies": {
    "@types/node": "latest",
    "playwright": "^1.61.1",
    "typescript": "latest"
  }
}
